# ─── Application ─────────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# ─── Database ────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sdicms
DB_USER=root
DB_PASSWORD=change_me
DB_CONNECTION_LIMIT=10

# ─── Authentication ──────────────────────────────────────────
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace_this_with_a_long_random_string
JWT_REFRESH_SECRET=replace_this_with_a_different_long_random_string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
BCRYPT_ROUNDS=12

# Account lockout
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# Password issued to accounts created by an administrator.
# IMPORTANT: never put a # in an unquoted .env value — everything after it
# is silently treated as a comment and dropped. If you want a password with
# a # or other special character, wrap the whole thing in double quotes,
# e.g.  DEFAULT_USER_PASSWORD="Sdicms#2026"
DEFAULT_USER_PASSWORD=Sdicms2026Reset

# ─── Uploads ─────────────────────────────────────────────────
STORAGE_PATH=./storage
MAX_UPLOAD_MB=100

# ─── Rate limiting ───────────────────────────────────────────
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=600
LOGIN_RATE_LIMIT_MAX=10

# ─── Logging ─────────────────────────────────────────────────
LOG_LEVEL=debug
